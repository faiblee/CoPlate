<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/rounded_rectangle"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/libraryDetailTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/app_text_primary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- Фиксированная высота: wrap_content + maxHeight у ScrollView в диалоге даёт нулевую высоту контента на части устройств. -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="360dp"
        android:layout_marginTop="12dp"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/dish_ingredients_section"
                android:textColor="@color/app_text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/libraryDetailIngredients"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingMultiplier="1.15"
                android:textColor="@color/app_text_body"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/libraryDetailDescriptionLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/dish_description_section"
                android:textColor="@color/app_text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/libraryDetailDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/app_text_body"
                android:textSize="15sp" />
        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/libraryDetailClose"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/action_button"
        android:backgroundTint="@null"
        android:text="@string/close"
        android:textAllCaps="false"
        android:textColor="@color/app_on_brand_button" />
</LinearLayout>
