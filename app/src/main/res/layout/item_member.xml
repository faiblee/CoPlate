<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:gravity="center_vertical">

    <FrameLayout
        android:layout_width="44dp"
        android:layout_height="44dp">

        <ImageView
            android:id="@+id/memberIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="bottom|center_horizontal"
            android:contentDescription="@null"
            android:src="@drawable/human" />

        <ImageView
            android:id="@+id/memberOwnerCrown"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="top|end"
            android:contentDescription="@string/family_owner_crown"
            android:src="@drawable/ic_owner_crown"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="16dp">

        <TextView
            android:id="@+id/memberName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Имя Участника"
            android:textSize="18sp"
            android:textColor="@color/app_text_primary"
            android:textStyle="bold"/>


    </LinearLayout>
    <Button
        android:id="@+id/kickButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Исключить"
        android:textSize="12sp"
        android:layout_marginStart="8dp"
        android:backgroundTint="@color/app_delete"
        android:textColor="@color/app_on_delete"
        android:visibility="gone" />
</LinearLayout>