<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/pick_day_of_week"
        android:textColor="#666666"
        android:textSize="13sp" />

    <Spinner
        android:id="@+id/addPlanDaySpinner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/pick_meal_type"
        android:textColor="#666666"
        android:textSize="13sp" />

    <Spinner
        android:id="@+id/addPlanMealSpinner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp" />

    <Button
        android:id="@+id/addPlanConfirmButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/button_background"
        android:backgroundTint="@null"
        android:text="@string/add_to_plan_action"
        android:textAllCaps="false"
        android:textColor="#FFFFFF" />
</LinearLayout>
