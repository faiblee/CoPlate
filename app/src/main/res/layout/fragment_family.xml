<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/app_window_background"
    tools:context=".Family">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView

            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:text="@string/Family"
            android:textColor="@color/app_text_primary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/settingsButton"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/settings"
            android:padding="4dp"
            android:src="@drawable/settings" />
    </LinearLayout>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/create_family"
        android:paddingStart="10dp"
        android:padding="10dp"
        android:textSize="16sp"
        android:textColor="@color/app_text_secondary"
        android:layout_marginBottom="24dp"
        android:layout_marginTop="10dp" />
    <Button
        android:id="@+id/createFamilyButton"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@drawable/button_background"
        android:backgroundTint="@null"
        android:text="Создать семью"
        android:textColor="@color/app_accent_green"
        android:textSize="22sp"
        android:textAllCaps="false"
        android:drawableEnd="@drawable/strelka_vniz_green"
        android:paddingStart="14dp"
        android:paddingEnd="12dp"
        android:layout_marginBottom="12dp"
        app:backgroundTint="@null"
        />
    <LinearLayout
        android:id="@+id/createFamilyContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:background="@drawable/rounded_rectangle"
        android:padding="16dp"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        android:layout_marginBottom="16dp">

        <EditText
            android:id="@+id/familyNameInput"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Название семьи"
            android:background="@drawable/btn_green_light"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColorHint="@color/app_text_muted"
            android:textColor="@color/app_text_primary"
            android:inputType="text" />

        <Button
            android:id="@+id/createSubmitButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Создать"
            android:textAllCaps="false"
            android:background="@drawable/btn_green_light"
            android:textColor="@color/app_text_primary"
            android:layout_marginTop="12dp"
            app:backgroundTint="@null"/>

    </LinearLayout>

    <Button
        android:id="@+id/joinFamilyButton"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@drawable/button_background"
        android:backgroundTint="@null"
        android:text="Присоединиться"
        android:textColor="@color/app_accent_green"
        android:textSize="22sp"
        android:textAllCaps="false"
        android:drawableEnd="@drawable/strelka_vniz_green"
        android:paddingStart="16dp"
        android:paddingEnd="12dp"
        android:layout_marginBottom="12dp"
        app:backgroundTint="@null"/>

    <LinearLayout
        android:id="@+id/joinFamilyContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:background="@drawable/rounded_rectangle"
        android:padding="16dp"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        android:layout_marginBottom="16dp">

        <EditText
            android:id="@+id/familyCodeInput"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Код для ввода"
            android:background="@drawable/btn_green_light"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColorHint="@color/app_text_muted"
            android:textColor="@color/app_text_primary"
            android:inputType="text" />

        <Button
            android:id="@+id/joinSubmitButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Присоединиться"
            android:textAllCaps="false"
            android:background="@drawable/btn_green_light"
            android:textColor="@color/app_text_primary"
            android:layout_marginTop="12dp"
            app:backgroundTint="@null"/>

    </LinearLayout>

    </LinearLayout>