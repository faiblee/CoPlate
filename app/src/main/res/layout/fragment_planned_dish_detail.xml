<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/rounded_rectangle"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/plannedDetailTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#1F2A24"
        android:textSize="20sp"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:maxHeight="380dp"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/dish_ingredients_section"
                android:textColor="#666666"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/plannedDetailIngredients"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingMultiplier="1.15"
                android:textColor="#333333"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/plannedDetailDescriptionLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/dish_description_section"
                android:textColor="#666666"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/plannedDetailDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#333333"
                android:textSize="15sp" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/plannedDetailClose"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/action_button"
            android:backgroundTint="@null"
            android:text="@string/close"
            android:textAllCaps="false"
            android:textColor="#1F2A24" />

        <Button
            android:id="@+id/plannedDetailRemove"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/action_button"
            android:backgroundTint="@null"
            android:text="@string/remove_dish_from_plan"
            android:textAllCaps="false"
            android:textColor="#C62828" />
    </LinearLayout>
</LinearLayout>
